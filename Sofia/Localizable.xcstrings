      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.4 GW offshore wind farm located on Dogger Bank in the central North Sea, about 195 km off the northeast coast of England. It comprises 100 Siemens Gamesa SG 14-222 DD turbines (14 MW each) spread over a 593 km² site. 100% owned by RWE, with full commissioning expected by the end of 2026."
          }
        }
      }
    },
